* {
  box-sizing: border-box;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background: linear-gradient(180deg, #0b1120 0%, #111827 100%);
  color: #f3f4f6;
}

button {
  font: inherit;
}

.app-shell {
  min-height: 100vh;
  padding: 24px;
  background: radial-gradient(circle at top, rgba(98, 117, 255, 0.35), transparent 40%), #091322;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(17, 24, 39, 0.8);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 20px;
  padding: 18px 22px;
  margin-bottom: 24px;
}

.brand-block {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-badge {
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  border-radius: 12px;
  background: linear-gradient(135deg, #4f46e5, #22d3ee);
  font-weight: 800;
}

.small-label {
  font-size: 11px;
  opacity: 0.8;
  letter-spacing: 0.1em;
}

.brand-block h1 {
  margin: 0;
  font-size: 1.2rem;
}

.nav-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.nav-actions button,
.user-box,
.primary,
.secondary,
.game-footer button,
.section-header button {
  border: 1px solid rgba(148, 163, 184, 0.2);
  background: rgba(15, 23, 42, 0.9);
  color: #f8fafc;
  border-radius: 12px;
  padding: 10px 16px;
  cursor: pointer;
}

.primary {
  background: linear-gradient(135deg, #4f46e5, #7c3aed);
  border: none;
}

.secondary {
  background: rgba(15, 118, 110, 0.25);
}

.user-box {
  padding-inline: 14px;
}

.content-wrap {
  display: grid;
  gap: 24px;
}

.hero-panel {
  display: grid;
  grid-template-columns: 1.6fr 1fr;
  background: linear-gradient(135deg, rgba(79, 70, 229, 0.28), rgba(59, 130, 246, 0.1));
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 24px;
  padding: 28px;
  gap: 18px;
}

.hero-copy h2 {
  margin: 12px 0;
  font-size: clamp(2rem, 4vw, 3.8rem);
  line-height: 1.1;
}

.hero-copy p {
  margin: 0 0 20px;
  max-width: 620px;
  color: #dbeafe;
  line-height: 1.7;
}

.tag {
  display: inline-block;
  background: rgba(56, 189, 248, 0.12);
  border: 1px solid rgba(56, 189, 248, 0.4);
  color: #a5f3fc;
  padding: 7px 12px;
  border-radius: 999px;
  font-size: 0.76rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.hero-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.hero-card {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 240px;
  background: linear-gradient(180deg, rgba(30, 41, 59, 0.6), rgba(15, 23, 42, 0.9));
  border-radius: 24px;
  border: 1px solid rgba(148, 163, 184, 0.18);
}

.mini-panel {
  width: 100%;
  max-width: 270px;
  padding: 18px;
  border-radius: 18px;
  background: rgba(148, 163, 184, 0.08);
  display: grid;
  gap: 16px;
}

.stat-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(15, 23, 42, 0.7);
  border-radius: 12px;
  padding: 12px 14px;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.stat-box {
  background: rgba(17, 24, 39, 0.8);
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 20px;
  padding: 18px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.stat-box span {
  opacity: 0.7;
}

.stat-box strong {
  font-size: 1.8rem;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.section-header h3 {
  margin: 0;
  font-size: 1.5rem;
}

.games-panel,
.leaderboard-panel {
  background: rgba(17, 24, 39, 0.8);
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 24px;
  padding: 22px;
}

.games-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.game-card {
  background: rgba(15, 23, 42, 0.95);
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 18px;
  overflow: hidden;
}

.game-card img {
  width: 100%;
  height: 220px;
  object-fit: cover;
  display: block;
}

.game-meta,
.game-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.game-meta {
  padding: 14px 14px 8px;
}

.category {
  background: rgba(59, 130, 246, 0.15);
  color: #93c5fd;
  border-radius: 999px;
  padding: 6px 10px;
  font-size: 0.72rem;
}

.rating {
  color: #fbbf24;
}

.game-card h4 {
  margin: 0;
  padding: 0 14px;
  font-size: 1.2rem;
}

.game-card p {
  color: #cbd5e1;
  margin: 10px 14px;
  line-height: 1.6;
  min-height: 72px;
}

.game-footer {
  padding: 0 14px 16px;
}

.game-footer button {
  background: linear-gradient(135deg, #22c55e, #14b8a6);
  border: none;
  color: white;
}

.leaderboard-list {
  display: grid;
  gap: 12px;
}

.leader-row {
  display: grid;
  grid-template-columns: 48px 1fr auto;
  align-items: center;
  padding: 12px 16px;
  background: rgba(15, 23, 42, 0.82);
  border-radius: 14px;
  border: 1px solid rgba(148, 163, 184, 0.16);
}

.place {
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: linear-gradient(135deg, #f59e0b, #f97316);
  font-weight: 800;
}

.player-name {
  font-weight: 600;
}

@media (max-width: 980px) {
  .topbar,
  .hero-panel,
  .games-grid,
  .stats-grid {
    grid-template-columns: 1fr;
    display: grid;
  }

  .nav-actions {
    justify-content: flex-start;
  }
}
